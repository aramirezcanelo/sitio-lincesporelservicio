{
  "name": "sitio-lincesporelservicio",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "devDependencies": {
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "clean": "npm run build:scripts && node scripts-build/clean.js",
    "build:js": "tsc -p tsconfig.json",
    "build:css": "tailwindcss -i ./static/tailwind.input.css -o ./static/tailwind.css --minify",
    "build": "npm run clean && npm run build:js && npm run build:css && npm run build:scripts && node scripts-build/prepare-site.js && npm run check:output",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:output": "node scripts-build/verify-output.js",
    "deploy": "npm run build && firebase deploy --only hosting"
  }
}
